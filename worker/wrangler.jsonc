{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "petty-thief",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "petty-thief", "migrations_dir": "migrations" }
  ]
}
