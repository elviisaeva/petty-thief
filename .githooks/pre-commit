#!/bin/sh
# .githooks/pre-commit — blocks commits that contain a Telegram bot token or a Petty Thief API token.
# Enable once per clone: git config core.hooksPath .githooks
if git diff --cached -U0 | grep -E '^\+' | grep -Eq '[0-9]{8,10}:[A-Za-z0-9_-]{35}|pt_[A-Za-z0-9]{32}'; then
  echo "pre-commit: this commit looks like it contains a secret token. Remove it and try again." >&2
  exit 1
fi
